# Host port mapped to the container (docker compose)
PORT=3000

# Public API base URL (Nuxt runtimeConfig.public.apiBase)
NUXT_PUBLIC_API_BASE=/api/v1

# Laravel backend URL (Nuxt server proxy target; match docker API_HTTP_PORT)
NUXT_BACKEND_API_URL=http://localhost:8080/api/v1

# Canonical site URL for SEO (sitemap, Open Graph, canonical links)
# Example production: https://midesk.io
NUXT_PUBLIC_SITE_URL=
